{
  "name": "dsh-calibration-tier",
  "version": "3.2.2",
  "author": "YokosWY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YokosWY/dsh-calibration-tier.git"
  },
  "homepage": "https://github.com/YokosWY/dsh-calibration-tier#readme",
  "bugs": {
