{
  "name": "@local/dsh-clarify-tier",
  "version": "1.8.4",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "description": "DSH 输入框档位条：一框三模式——思考（常规/严格/极致）、循环（轻量/交付/极致）、对抗（可叠加）；模型通过 clarify_tier 与 forge_level 读取。",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "node scripts/check.mjs",
    "verify": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "scripts",
    "install-profile.ps1",
    "skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
